{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Skill permissions match IDs, not source directories. Only repo-local
    // skills and OpenCode's built-in help skill are allowed in this project.
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "opencode", "effect": "allow" },

