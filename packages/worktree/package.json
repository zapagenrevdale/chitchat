{
  "name": "@chitchat/worktree",
  "private": true,
  "bin": {
    "cc-worktree": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "worktree:setup": "bun src/cli.ts setup",
    "worktree:status": "bun src/cli.ts status",
    "worktree:teardown": "bun src/cli.ts teardown",
    "worktree:smoke": "bun src/cli.ts smoke",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "test": "bun test"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "portless": "0.15.6",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1"
  }
}
