{
  "name": "@chitchat/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cc-worktree dev web",
    "dev:app": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy baseLocale"
  },
  "dependencies": {
    "@chitchat/contracts": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/shantell-sans": "5.3.0",
    "@google/genai": "2.22.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.52",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@chitchat/worktree": "workspace:*",
    "@cloudflare/vite-plugin": "1.54.7",
    "@inlang/paraglide-js": "2.25.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.35",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "react-grab": "0.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  },
  "portless": {
    "name": "chitchat",
    "script": "dev:app"
  }
}
