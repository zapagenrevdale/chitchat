WEB_ORIGIN=https://chitchat.local
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/chitchat
BETTER_AUTH_URL=https://api.chitchat.local
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Required for voice practice; never expose via VITE_*.
# Uses gemini-3.1-flash-live-preview. The general key takes precedence; LIVE is used only if it is missing.
GEMINI_API_KEY_LIVE=
GEMINI_API_KEY=

# Optional tracing. Both keys enable it; never expose these via VITE_*.
# Use the base URL of your Langfuse region or self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The same Gemini key also provisions gemini-3.5-transcribe-live captions.
