{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ],
  "globalPassThroughEnv": [
    "PORTLESS",
    "PORTLESS_*",
    "NODE_EXTRA_CA_CERTS",
    "CHITCHAT_WORKTREE_HOME",
    "XDG_STATE_HOME",
    "DOCKER_*",
    "SSH_AUTH_SOCK"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:auth": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["AUTH_INTEGRATION_DATABASE_URL"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "migrate:deploy": {
      "cache": false
    },
    "worktree:setup": {
      "cache": false
    },
    "worktree:status": {
      "cache": false
    },
    "worktree:teardown": {
      "cache": false
    },
    "worktree:smoke": {
      "cache": false
    },
    "generate:introductions": {
      "cache": false
    },
    "generate:chit-introductions": {
      "cache": false
    },
    "generate:avatars": {
      "cache": false
    },
    "generate:places": {
      "cache": false
    },
    "@chitchat/backend#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/public/images/personas/**"
      ]
    },
    "@chitchat/web#i18n:compile": {
      "inputs": ["messages/**", "project.inlang/settings.json", "package.json"],
      "outputs": ["src/paraglide/**"]
    },
    "@chitchat/web#build": {
      "dependsOn": ["^build", "i18n:compile"],
      "outputs": ["dist/**"]
    },
    "@chitchat/web#typecheck": {
      "dependsOn": ["^build", "i18n:compile"]
    },
    "@chitchat/web#test": {
      "dependsOn": ["^build", "i18n:compile"]
    },
    "@chitchat/web#lint": {
      "dependsOn": ["^build", "i18n:compile"]
    }
  }
}
